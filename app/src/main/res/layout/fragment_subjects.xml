<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SubjectsFragment"
    android:id="@+id/frameLayoutSubject"
    style="@style/Main_BG"
    >
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
        <!--        Main Linear Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/title_subjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp"
                android:text="SUBJECTS"
                style="@style/TEXT_BG"
                android:textSize="20sp"
                android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btnSub1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonBG"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/icon_book_shell" />
                    <TextView
                        android:id="@+id/title_subject_name1"
                        style="@style/TEXT_BG"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="2"
                        android:text="@string/subject_i"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSub2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonBG"
                    android:layout_marginBottom="20dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/icon_book_shell" />
                    <TextView
                        android:id="@+id/title_subject_name2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="2"
                        android:text="@string/subject_ii"
                        style="@style/TEXT_BG"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSub3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonBG"
                    android:layout_marginBottom="20dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/icon_book_shell" />
                    <TextView
                        android:id="@+id/title_subject_name3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="2"
                        android:text="@string/subject_iii"
                        style="@style/TEXT_BG"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSub4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonBG"
                    android:layout_marginBottom="20dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/icon_book_shell" />
                    <TextView
                        android:id="@+id/title_subject_name4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="2"
                        android:text="@string/subject_iv"
                        style="@style/TEXT_BG"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSub5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonBG"
                    android:layout_marginBottom="20dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/icon_book_shell" />
                    <TextView
                        android:id="@+id/title_subject_name5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="2"
                        android:text="@string/subject_v"
                        style="@style/TEXT_BG"
                        android:textSize="22sp" />
                </LinearLayout>

        </LinearLayout>
</ScrollView>
</FrameLayout>