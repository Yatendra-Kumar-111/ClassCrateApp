<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ClassCrate1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/app_bg_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!--    Dark mode  -->
    <style name="Main_BG">
        <item name="android:background">#121212</item>
    </style>

    <style name="ButtonBG">
        <item name="android:background">@drawable/bg_btn_dark</item>
        <item name="android:switchStyle">@id/accessibility_custom_action_14</item>
    </style>

    <style name="TEXT_BG">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@null</item>
    </style>


    <style name="Theme.ClassCrate1.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" >
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="YT_Text_BG">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_btn_dark</item>
        <item name="android:switchStyle">@id/accessibility_custom_action_14</item>
        <item name="android:padding">5dp</item>
    </style>

    <style name="ScreenBackground" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="layout">@color/purple_200</item>
        <item name="android:itemBackground">@color/teal_200</item>
    </style>

    <style name="ThemeOverlay.ClassCrate1.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_900</item>
        <item name="fullscreenTextColor">@color/light_blue_A400</item>
    </style>
</resources>