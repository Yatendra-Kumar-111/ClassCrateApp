<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
<!--    <style name="Base.Theme.ClassCrate1" parent="Theme.Material3.DayNight.NoActionBar">-->
    <style name="Base.Theme.ClassCrate1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->

        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>


        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

    </style>


    <!--    Light mode  -->
    <style name="Main_BG">
        <item name="android:background">#F5F0FA</item>
    </style>
    <style name="ButtonBG">
        <item name="android:background">@drawable/bg_btn</item>
    </style>
    <style name="TEXT_BG">
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@null</item>
<!--        <item name="android:textStyle">bold</item>-->
<!--        <item name="android:textAllCaps">true</item>-->
    </style>

    <style name="YT_Text_BG">
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/bg_btn</item>
    </style>





    <style name="Theme.ClassCrate1" parent="Base.Theme.ClassCrate1" />

    <style name="Theme.ClassCrate1.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.ClassCrate1.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.ClassCrate1.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ThemeOverlay.ClassCrate1.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>
</resources>